{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RAISE Research Workstation",
  "version": "1.0.0",
  "identifier": "org.raise.workstation",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix ../../frontend",
    "beforeBuildCommand": "npm run build --prefix ../../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "RAISE AI Workstation",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 650,
        "theme": "Dark",
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
