# ==============================================================================
# RAISE (Research Assessment Intelligence & Semantic Extraction)
# Environment Configuration Template (RAG/.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' (do NOT commit your real '.env' to git):
#      cp .env.example .env
# 2. Fill in your environment-specific credentials and connection strings.
# 3. All passwords, tokens, and secrets below are sanitized placeholders.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FastAPI Application Server
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. CORS & Network Security
# Allowed origins for frontend clients (GitHub Pages, localhost, Cloudflare)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database (Persistent Chat Logs & Metadata)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=raise_db
POSTGRES_USER=raise_user
POSTGRES_PASSWORD=your_secure_postgres_password_here

# ------------------------------------------------------------------------------
# 4. Redis In-Memory Cache (Sub-millisecond Query Caching & TTL)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 5. Neo4j Property Graph Database (Knowledge Graph & Entity Traversal)
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_neo4j_password_here
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=5.0

# ------------------------------------------------------------------------------
# 6. ChromaDB Vector Store & Embeddings
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./.chromadb_bge_large
CHROMA_COLLECTION_NAME=raise_docling_bge_large
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=cuda
EMBEDDING_DIMENSION=1024
CHROMA_HNSW_SPACE=cosine

# ------------------------------------------------------------------------------
# 7. Multi-Backend AI Inference Layer
# Local vLLM default (port 8002) + Cloud Providers (Gemini, Groq, DeepSeek, NVIDIA, Cohere)
# Credentials can also be securely managed via Windows Credential Locker (DPAPI)
# ------------------------------------------------------------------------------
VLLM_BASE_URL=http://localhost:8002/v1
VLLM_MODEL_NAME=Qwen/Qwen2.5-14B-Instruct-GPTQ-Int4

# Cloud API Key Placeholders (Never commit actual keys)
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=

LLM_BACKEND=vllm
LLM_MODEL_NAME=Qwen/Qwen2.5-14B-Instruct-GPTQ-Int4
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TOP_P=0.9
LLM_REQUEST_TIMEOUT=120.0


# ------------------------------------------------------------------------------
# 8. LangGraph Multi-Hop Traversal Parameters
# ------------------------------------------------------------------------------
GRAPHRAG_DEFAULT_HOPS=2
GRAPHRAG_MAX_HOPS=3
GRAPHRAG_DEFAULT_TOP_K=4
GRAPHRAG_MAX_NODES=35
LANGGRAPH_MAX_RETRIES=1
LANGGRAPH_TRACE_LEVEL=INFO

# ------------------------------------------------------------------------------
# 9. Cloudflare R2 Object Storage (Zero-Cost Free-Tier Guardrails Active)
# Safe monthly free-tier caps enforced in code: 5GB storage, 100k Class A, 1M Class B.
# Automatic fallback to local disk storage if unconfigured or threshold reached.
# ------------------------------------------------------------------------------
CLOUDFLARE_R2_ENDPOINT_URL=https://<your-cloudflare-account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id_here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
CLOUDFLARE_R2_BUCKET_NAME=raise-documents

# ------------------------------------------------------------------------------
# 10. Cloudflare Named Tunnel (Zero Trust Ingress)
# Required only if running cloudflared inside Docker using a named tunnel token.
# Not required if running an anonymous Quick Tunnel or local development.
# ------------------------------------------------------------------------------
# TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ------------------------------------------------------------------------------
# 11. Hugging Face Hub (Optional, for downloading gated model weights)
# ------------------------------------------------------------------------------
# HF_TOKEN=your_huggingface_token_here

# ------------------------------------------------------------------------------
# 12. Developer Superuser Reset Token (for dev_main.py "purge all")
# ------------------------------------------------------------------------------
RAISE_DEV_PURGE_TOKEN=sid
