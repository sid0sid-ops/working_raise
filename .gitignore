# Environment & Secrets (Never commit credentials)
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Compiled Binaries, Executables & Installers
bin/
*.exe
*.msi
*.dll
*.so
*.dylib
*.pyd

# Vector Stores, Embeddings & Large Runtime DBs
.chromadb*/
**/.chromadb*/
RAG/.chromadb_bge_large/
.chromadb_bge_large/
data/chromadb/
data/processed/chroma/
**/data/chromadb/
**/data/processed/chroma/
*.sqlite
*.sqlite3
*.db
.runtime/
**/.runtime/

# Python Build & Caching
__pycache__/
*.py[cod]
*$py.class
.cache/
**/.cache/
RAG/.cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
RAISE_SRC/

# Rust Build Artifacts
target/
**/target/
wheels/
**/wheels/

# Virtual Environments
.venv/
env/
venv/

# Temporary Scratch Scripts & Test Environments
scratch/
tmp/
.gemini/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Logs & Archives
*.log
*.zip
*.tar.gz
*.tgz

# Pipeline Runtime Outputs & Handoff Deliverables
outputs/*
!outputs/.gitkeep
data/output/*
!data/output/.gitkeep
data/downloads/*
!data/downloads/.gitkeep
data/input/*
!data/input/.gitkeep
!data/schemas/*

# Local Research & Offline Reference Data (Never commit)
Artifacts/
reference/

# Isolated Frontend Branch Workspace (Managed separately)
frontend/
