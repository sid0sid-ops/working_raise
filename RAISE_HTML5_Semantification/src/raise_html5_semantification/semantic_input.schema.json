{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raise.example/schemas/semantic_input.schema.json",
  "title": "RAISE Prepared Annual Report Blocks",
  "description": "Filtered, research-assessment-only blocks handed to Stage 3 (RAISE_HTML5_Semantification). Self-contained schema aligned with upstream target_blocks.schema.json.",
  "oneOf": [
    {
      "type": "array",
      "items": { "$ref": "#/$defs/block" }
    },
    {
      "type": "object",
      "required": ["source_file", "blocks"],
      "additionalProperties": true,
      "properties": {
        "source_file": { "type": "string" },
        "stage": { "type": "string", "const": "target_blocks" },
        "schema_version": { "type": "string" },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        },
        "filtering_metadata": { "$ref": "#/$defs/filtering_metadata" }
      }
    },
    {
      "type": "object",
      "not": {
        "required": ["source_file", "blocks"]
      },
      "additionalProperties": true
    }
  ],
  "$defs": {
    "exclusion_record": {
      "type": "object",
      "required": ["page_number", "reason", "category"],
      "properties": {
        "page_number": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["financial_audit", "photo_gallery", "directory", "admin_notice"]
        },
        "score": { "type": "number" },
        "matched_signals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "filtering_metadata": {
      "type": "object",
      "required": ["input_block_count", "output_block_count", "retained_pages"],
      "properties": {
        "input_block_count": { "type": "integer", "minimum": 0 },
        "output_block_count": { "type": "integer", "minimum": 0 },
        "input_page_count": { "type": "integer", "minimum": 0 },
        "retained_pages": { "type": "array", "items": { "type": "integer" } },
        "excluded_pages": {
          "type": "array",
          "items": { "$ref": "#/$defs/exclusion_record" }
        },
        "removed_boilerplate_block_count": { "type": "integer", "minimum": 0 },
        "boilerplate_examples": { "type": "array", "items": { "type": "string" } },
        "rules_version": { "type": "string" }
      }
    },
    "block": {
      "type": "object",
      "properties": {
        "block_id": { "type": ["string", "number"] },
        "page_number": { "type": ["integer", "null"] },
        "text": { "type": ["string", "number", "null"] },
        "bbox": {
          "anyOf": [
            { "type": "array", "items": { "type": "number" } },
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "x0": { "type": ["number", "null"] },
        "y0": { "type": ["number", "null"] },
        "x1": { "type": ["number", "null"] },
        "y1": { "type": ["number", "null"] },
        "font_size": { "type": ["number", "null"] },
        "font_name": { "type": ["string", "null"] },
        "is_bold": { "type": ["boolean", "null"] },
        "is_italic": { "type": ["boolean", "null"] },
        "reading_order": { "type": ["integer", "null"] },
        "block_type_guess": {
          "type": ["string", "null"],
          "enum": ["heading", "paragraph", "list_item", "table", "page_number", "empty", "image", "figure", "chart", "diagram", null]
        },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "section_hint": { "type": ["string", "null"] },
        "source_file": { "type": ["string", "null"] },
        "image_path": { "type": ["string", "null"] },
        "image_src": { "type": ["string", "null"] },
        "caption": { "type": ["string", "null"] },
        "alt_text": { "type": ["string", "null"] },
        "rows": {
          "type": ["array", "null"],
          "items": {
            "type": "array",
            "items": {}
          }
        },
        "table": {
          "type": ["array", "null"],
          "items": {
            "type": "array",
            "items": {}
          }
        },
        "line_count": { "type": ["integer", "null"] },
        "word_count": { "type": ["integer", "null"] },
        "column_index": { "type": ["integer", "null"] }
      },
      "additionalProperties": true
    }
  }
}
