# ==============================================================================
# RAISE ACADEMIC GRAPHRAG — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEO4J GRAPH DATABASE (Industry Standard GraphRAG Substrate)
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
# For Docker Compose internal network, use:
# NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_INITIAL_SIZE=512m
NEO4J_HEAP_MAX_SIZE=2G
NEO4J_PAGECACHE_SIZE=1G

# ------------------------------------------------------------------------------
# 2. VECTOR DATABASE & EMBEDDINGS (Local Dense Cosine Substrate)
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=RAG/.runtime/.chromadb
CHROMA_COLLECTION_NAME=raise_graphrag_chunks
# Options:
#  - sentence-transformers/all-MiniLM-L6-v2 (Fast 384-dim, 100% offline)
#  - BAAI/bge-m3 (SOTA Multilingual Dense+Sparse)
#  - Qwen/Qwen3-Embedding-4B (High Precision)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=384
CHROMA_HNSW_SPACE=cosine

# ------------------------------------------------------------------------------
# 3. LLM INFERENCE (Local Ollama / vLLM / HuggingFace)
# ------------------------------------------------------------------------------
# Options: ollama | huggingface | openai-compatible
LLM_BACKEND=ollama
# Recommended offline models: qwen2.5:7b, llama3.1:8b, mistral:7b
LLM_MODEL_NAME=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
# For Docker Compose internal network, use:
# OLLAMA_BASE_URL=http://ollama:11434
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TOP_P=0.9
LLM_REQUEST_TIMEOUT=60.0

# ------------------------------------------------------------------------------
# 4. LANGGRAPH PIPELINE & AGENTIC TRAVERSAL
# ------------------------------------------------------------------------------
GRAPHRAG_DEFAULT_HOPS=2
GRAPHRAG_MAX_HOPS=3
GRAPHRAG_DEFAULT_TOP_K=4
GRAPHRAG_MAX_NODES=35
LANGGRAPH_MAX_RETRIES=1
LANGGRAPH_TRACE_LEVEL=DEBUG

# ------------------------------------------------------------------------------
# 5. WEB APPLICATION SERVER
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=info
