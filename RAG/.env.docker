# ==============================================================================
# RAISE Academic GraphRAG Studio — Container Environment Variables
# Copy or mount to container runtime for Docker Compose execution
# ==============================================================================

# --- 1. Neo4j Graph Database ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- 2. ChromaDB Vector Store & Embedding Configuration ---
CHROMA_PERSIST_DIRECTORY=/app/.runtime/.chromadb
CHROMA_COLLECTION_NAME=raise_graphrag_chunks
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=384

# --- 3. Local LLM & Ollama Configuration ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_TIMEOUT=120

# --- 4. Server & Feature Configuration ---
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO
ENABLE_TRUE_STREAMING=true
ENABLE_CLAIM_VERIFICATION=true

