# Canonical RAISE API Gateway URL (default port 8000 on Windows Workstation)
VITE_API_BASE_URL=http://localhost:8000

# Operational Mode: 'mock' | 'remote' | 'auto'
# - mock: deterministically return local fixtures without network access
# - remote: direct HTTP calls to VITE_API_BASE_URL
# - auto: probe backend at startup; fallback gracefully to mock if unreachable
VITE_API_MODE=auto
